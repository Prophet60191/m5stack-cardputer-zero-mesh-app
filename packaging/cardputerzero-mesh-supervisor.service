[Unit]
Description=Cardputer Zero Mesh radio supervisor

[Service]
Type=simple
ExecStart=/usr/lib/cardputerzero-mesh/run-supervisor
ExecStopPost=/usr/bin/python3 /usr/lib/cardputerzero-mesh/radio_guardian.py --runtime %t/cz-mesh --cleanup
KillMode=control-group
TimeoutStopSec=15
Restart=on-failure
RestartSec=3
UMask=0077
# The app reads a fresh verdict from the separate capability-only firewall
# service. It never launches a privileged helper during normal operation.
NoNewPrivileges=true
