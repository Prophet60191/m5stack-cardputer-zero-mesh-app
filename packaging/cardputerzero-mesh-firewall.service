[Unit]
Description=Confine the Meshtastic local API
Before=network-pre.target
Wants=network-pre.target
After=local-fs.target

[Service]
Type=simple
User=cz-mesh-firewall
Group=cz-mesh-firewall
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_NETLINK
RuntimeDirectory=cardputerzero-mesh-firewall
RuntimeDirectoryMode=0755
ExecStartPre=/usr/lib/cardputerzero-mesh/firewall-setup.sh ensure
ExecStart=/usr/lib/cardputerzero-mesh/firewall-setup.sh monitor
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
