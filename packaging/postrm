#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
if [ "${1:-}" = remove ] || [ "${1:-}" = purge ]; then
    if [ -d /run/systemd/system ]; then
        systemctl stop cardputerzero-mesh-firewall.service || true
        systemctl disable cardputerzero-mesh-firewall.service || true
        systemctl daemon-reload
    fi
fi

if [ "${1:-}" = remove ] || [ "${1:-}" = purge ]; then
    # Only Essential tools are available if dependencies were removed before purge.
    rm -f -- /run/cardputerzero-mesh-package-update
fi
