#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
if [ "${1:-}" = remove ] || [ "${1:-}" = purge ]; then
    if [ -d /run/systemd/system ]; then
        systemctl stop cardputerzero-mesh-firewall.service || true
        systemctl disable cardputerzero-mesh-firewall.service || true
        systemctl daemon-reload
    fi
fi

if [ "${1:-}" = remove ] || [ "${1:-}" = purge ]; then
    /usr/bin/python3 -I -c 'from pathlib import Path; Path("/run/cardputerzero-mesh-package-update").unlink(missing_ok=True)'
fi
