"""dpkg lifecycle only: stop this package's user service before file replacement."""
import os
from pathlib import Path
import pwd
import stat
import subprocess
import sys

UNIT='cardputerzero-mesh-supervisor.service'
MARKER=Path('/run/cardputerzero-mesh-package-update')
if os.geteuid()!=0:raise SystemExit('Package lifecycle requires the package manager')
if len(sys.argv)>1 and sys.argv[1] in ('install','upgrade'):
    fd=os.open(MARKER,os.O_WRONLY|os.O_CREAT|os.O_TRUNC|os.O_NOFOLLOW,0o644)
    with os.fdopen(fd,'w') as f:f.write('Package installation in progress; finish dpkg configuration before reopening Mesh.\n')
if not Path('/run/systemd/system').is_dir():raise SystemExit(0)
parents=Path('/run/user')
if not parents.is_dir():raise SystemExit(0)
users=[p for p in parents.iterdir() if p.name.isdecimal() and 0<int(p.name)<2**31]
if len(users)>32:raise SystemExit('Too many user sessions; close Mesh and retry installation')
for runtime in users:
    uid=int(runtime.name)
    try:
        st=runtime.lstat();bus=(runtime/'bus').lstat();user=pwd.getpwuid(uid).pw_name
    except (OSError,KeyError):continue
    if not stat.S_ISDIR(st.st_mode) or st.st_uid!=uid or st.st_mode&0o077 or not stat.S_ISSOCK(bus.st_mode) or bus.st_uid!=uid:continue
    cmd=['/usr/sbin/runuser','-u',user,'--','/usr/bin/env','XDG_RUNTIME_DIR='+str(runtime),
         'DBUS_SESSION_BUS_ADDRESS=unix:path='+str(runtime/'bus'),'/usr/bin/systemctl','--user']
    r=subprocess.run(cmd+['stop',UNIT],stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=25)
    if r.returncode:
        state=subprocess.run(cmd+['show','--property=LoadState','--value',UNIT],capture_output=True,text=True,timeout=5)
        if state.stdout.strip()!='not-found':raise SystemExit('Unable to stop Mesh user service; close Mesh and retry installation')
